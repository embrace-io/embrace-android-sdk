#!/usr/bin/env bash
# tools/startup - run the SDK startup-analysis toolchain.
#
# Builds the :embrace-analysis-cli module incrementally (a warm Gradle daemon makes a no-op build take
# a second or two) and then execs the generated launcher directly, so the tool runs as a plain JVM
# process with real stdin, real exit codes and working terminal detection - none of which survive
# `./gradlew run`. Set STARTUP_TOOLS_NO_BUILD=1 to skip the build when iterating on data only.
#
# Usage:  tools/startup <command> [args...]      e.g.  tools/startup --help
set -euo pipefail

# CDPATH is cleared so cd never prints the directory into REPO.
REPO="$(CDPATH= cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAUNCHER="$REPO/embrace-analysis-cli/build/install/startup-tools/bin/startup-tools"

if [[ -z "${STARTUP_TOOLS_NO_BUILD:-}" ]]; then
  "$REPO/gradlew" -q --console=plain -p "$REPO" :embrace-analysis-cli:installDist
elif [[ ! -x "$LAUNCHER" ]]; then
  echo "startup-tools: no built launcher at $LAUNCHER and STARTUP_TOOLS_NO_BUILD is set" >&2
  exit 2
fi

# The commands resolve repository paths (such as claude-output) against this checkout, not against whichever
# directory the caller is in.
export STARTUP_TOOLS_REPO="$REPO"
exec "$LAUNCHER" "$@"
