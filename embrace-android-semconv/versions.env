# Version of the OpenTelemetry Weaver CLI used to generate the semantic-convention sources.
# Renovate (.github/renovate.json) bumps it in one PR with the setup-weaver action pins in
# .github/workflows/semconv-drift.yml, so the action and the CLI it installs come from one release.
# When changing it by hand, move those pins to the same release.
WEAVER_VERSION=v0.26.1
