      "enable_traceparent_injection": false,
      "traceparent_only_allow_domains": [
        "example.com"
      ]
    },
    "capture_public_key": "key",
    "sensitive_keys_denylist": [
      "password"
    ],
    "anr": {
      "capture_unity_thread": true
    },
    "app": {
      "report_disk_usage": false
    },
    "background_activity": {
      "capture_enabled": true
    },
    "base_urls": {
      "config": "https://config.example.com",
      "data": "https://data.example.com"
    },
    "sig_handler_detection": false,
    "app_exit_info": {
      "aei_enabled": true
    },
    "app_framework": "native"
  },
  "unity": {
    "symbols_archive_name": "symbols.zip"
  }
